{
  "name": "pc-test-online",
  "version": "0.1.0",
  "description": "Web app for testing PC hardware online",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "vue": "3.5.46",
    "vue-router": "4.6.5",
    "vue-i18n": "11.4.24"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.11",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "5.1.2",
    "@vue/test-utils": "2.6.0",
    "eslint": "10.15.0",
    "@eslint/js": "10.0.1",
    "eslint-plugin-vue": "10.12.1",
    "happy-dom": "21.0.4",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2",
    "vue-tsc": "3.3.14"
  }
}
